# IntelliGate Environment Configuration
APP_NAME=IntelliGate
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false

# Security (Generate secure random values in production)
SECRET_KEY=replace-with-a-64-character-random-hex-string
FERNET_KEY=replace-with-a-fernet-key-from-Fernet.generate_key()
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intelligate
REDIS_URL=redis://localhost:6379/0

# Gateway Defaults
DEFAULT_ROUTING_STRATEGY=priority
CACHE_DEFAULT_TTL_SECONDS=3600
RATE_LIMIT_DEFAULT_RPM=600
RATE_LIMIT_DEFAULT_TPM=1000000

# Observability
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true

