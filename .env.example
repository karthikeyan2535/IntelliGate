# IntelliGate Environment Configuration
APP_NAME=IntelliGate
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Security Keys
SECRET_KEY=e3d5bfe7559507229598486a27b1d174a195c7c1e6b568271e204015e9b049f6
FERNET_KEY=HPcCDO2RT6rJ1vRa3O3XtvlsyOaZG1yjHl0FUyUO32E=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Upstream LLM Provider API Keys (Add any or all of these)
# 1. Groq (Fastest inference, free tier available at https://console.groq.com/keys)
GROQ_API_KEY=

# 2. Google Gemini (Free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 3. OpenAI (From https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Database & Cache (Defaults to SQLite & in-memory cache if Postgres/Redis are not running)
DATABASE_URL=sqlite+aiosqlite:///./intelligate.db
REDIS_URL=redis://localhost:6379/0

# Gateway Defaults
DEFAULT_ROUTING_STRATEGY=intelligent
CACHE_DEFAULT_TTL_SECONDS=3600
RATE_LIMIT_DEFAULT_RPM=600
RATE_LIMIT_DEFAULT_TPM=1000000

# Observability
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true
